#!/usr/bin/env bash
# language: Bash, file: archshield-panel, target: Linux
# Resolve o diretório real mesmo através de symlinks
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
BASE_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

export PYTHONUNBUFFERED=1
exec python3 "$BASE_DIR/panel.py" "$@"
