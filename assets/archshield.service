[Unit]
Description=ArchShield PRO - Sovereign Cyber Deception & Intrusion Prevention Daemon
After=network.target network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/archshield-daemon
Restart=always
RestartSec=3
KillMode=process
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
